# cPanel MySQL connection
# Copy this file to .env.local on your computer.
# NEVER commit .env.local or share the DB password.

DB_HOST=your-cpanel-mysql-host
DB_PORT=3306
DB_NAME=your_cpanel_database_name
DB_USER=your_cpanel_database_user
DB_PASSWORD=your_database_password

# Used to sign the admin session cookie. Use a random value of 32+ characters.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
